# ==============================================================================
# NIVA — .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Build Outputs
dist/
build/
.next/
out/
*.tsbuildinfo
*.tgz

# Python & AI Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.prod.test
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.crt
id_rsa*

# Explicit exception: Commit the example template
!.env.example

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/

# Docker Local Storage & Temporary Files
.docker/
docker-data/
postgres_data/
redis_data/
tmp/
scratch/
