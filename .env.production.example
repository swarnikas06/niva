# ==============================================================================
# NIVA — Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# SAFE TEMPLATE: Contains ONLY placeholders and recommended production settings.
# NEVER commit real credentials, production secrets, or private keys to source control.
# Copy this template to your production secret manager (e.g., Doppler, AWS Secrets
# Manager, Railway/Render Environment Variables, Vercel Project Settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & LOGGING
# ------------------------------------------------------------------------------
# Set to 'production' to enforce strict security checks, disable verbose stack traces,
# and mandate internal service authentication.
NODE_ENV=production
LOG_LEVEL=info

# Service Ports (Standard Internal Port Allocation)
PORT=4000
API_PORT=4000
WEB_PORT=3000
AI_PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Production connection string with SSL required. For managed providers (Neon,
# Supabase, AWS RDS, Railway), ensure sslmode=require and pgvector extension enabled.
DATABASE_URL=postgresql://niva_prod_user:SECURE_DB_PASSWORD_HERE@prod-db.example.com:5432/niva_prod?sslmode=require&schema=public

# Connection Pool Tuning (NestJS node-postgres / pg pool)
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE & LOCKING (Redis 7.2+)
# ------------------------------------------------------------------------------
# In production, use TLS (rediss://) for managed Redis (Upstash, AWS ElastiCache).
# Used for session token blacklisting, verification tokens, rate limiting, and locks.
REDIS_URL=rediss://default:SECURE_REDIS_PASSWORD_HERE@prod-redis.example.com:6380
REDIS_TLS_ENABLED=true

# ------------------------------------------------------------------------------
# 4. APPLICATION SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate cryptographically secure random 64-character hex strings:
# openssl rand -hex 32
JWT_SECRET=GENERATE_SECURE_RANDOM_64_CHAR_HEX_SECRET_FOR_JWT
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Cookie encryption and session signature
COOKIE_SECRET=GENERATE_SECURE_RANDOM_64_CHAR_HEX_SECRET_FOR_COOKIES

# Shared Internal Secret for Service-to-Service Security (NestJS API <-> FastAPI AI)
# Must be IDENTICAL across NestJS and FastAPI services.
# Requests without header X-Niva-Internal-Secret matching this value will receive 401 Unauthorized.
NIVA_INTERNAL_SECRET=GENERATE_SECURE_RANDOM_64_CHAR_HEX_INTERNAL_SERVICE_SECRET

# ------------------------------------------------------------------------------
# 5. AI ENGINE & PROVIDER ORCHESTRATION (FastAPI + Google Gemini)
# ------------------------------------------------------------------------------
# Internal URL where NestJS API communicates with Python FastAPI AI service.
# In production container networking, use internal DNS (e.g. http://ai:8000 or private VPC).
# NEVER expose the AI service directly to the public Internet.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=90000

# Google Gemini API Production Key (Pay-as-you-go / Tier 1 account required)
# Free Tier has 20-50 RPD quota limits that cause 429 Cascading Lockouts.
GEMINI_API_KEY=YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY_HERE
DEFAULT_AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.8-flash
AI_EMBEDDING_MODEL_NAME=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_SECONDS=45.0
FORCE_MOCK_PROVIDER=false

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL OUTBOUND EMAIL (Resend or SMTP)
# ------------------------------------------------------------------------------
# Primary outbound email provider: Resend API (Recommended for domain production)
# Sign up at https://resend.com, verify your custom domain, and generate an API key.
RESEND_API_KEY=re_YOUR_PRODUCTION_RESEND_API_KEY_HERE
EMAIL_FROM="NIVA Companion <support@yourcustomdomain.com>"

# Zero-Cost / Development SMTP: Gmail SMTP
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords with 2FA enabled:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_google_app_password
# EMAIL_FROM="NIVA Companion <your_email@gmail.com>"

# Commercial Production SMTP (SendGrid, Mailgun, AWS SES, Postmark)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_PRODUCTION_SMTP_PASSWORD_OR_API_KEY_HERE
SMTP_PASS=YOUR_PRODUCTION_SMTP_PASSWORD_OR_API_KEY_HERE
SMTP_SECURE=false
ENABLE_LOCAL_EMAIL_CAPTURE=false

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH SINGLE SIGN-ON
# ------------------------------------------------------------------------------
# Configured in Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: https://api.yourcustomdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=https://api.yourcustomdomain.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. BROWSER PUSH NOTIFICATIONS (WebPush VAPID)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_PRODUCTION_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_PRODUCTION_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:security@yourcustomdomain.com

# ------------------------------------------------------------------------------
# 9. FRONTEND PUBLIC ENVIRONMENT (Next.js client-side variables)
# ------------------------------------------------------------------------------
# Must be absolute public HTTPS URLs accessible by end users' web browsers
NEXT_PUBLIC_APP_URL=https://niva.yourcustomdomain.com
NEXT_PUBLIC_API_URL=https://api.yourcustomdomain.com/api/v1
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_PRODUCTION_VAPID_PUBLIC_KEY_HERE

# ------------------------------------------------------------------------------
# 10. CORS, PROXY & INFRASTRUCTURE INTEGRATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser CORS enforcement
CORS_ALLOWED_ORIGINS=https://niva.yourcustomdomain.com

# Set to 1 if behind reverse proxy / load balancer (Cloudflare, AWS ALB, Nginx)
TRUST_PROXY=1
