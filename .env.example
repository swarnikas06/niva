# ==============================================================================
# NIVA — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development. NEVER commit .env with real credentials.

# ------------------------------------------------------------------------------
# 1. General & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Ports Configuration (Phase 0 Standard Allocation)
# ------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
AI_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=niva_user
POSTGRES_PASSWORD=niva_dev_password_local_only
POSTGRES_DB=niva_db
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://niva_user:niva_dev_password_local_only@localhost:5432/niva_db?schema=public

# ------------------------------------------------------------------------------
# 4. Cache & Queue (Redis 7.2)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. AI Service (Python FastAPI & AI Provider)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.8-flash
AI_EMBEDDING_MODEL_NAME=gemini-embedding-001

# ------------------------------------------------------------------------------
# 6. Security, Tokens & Authentication (Server-Side Only)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 7. Outbound Transactional Email (Zero-Cost Gmail SMTP or Resend)
# ------------------------------------------------------------------------------
# Zero-Cost Option: Gmail SMTP (for dev and testing)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other (NIVA)")
# 3. Fill in your Gmail address and 16-char App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM="NIVA Companion <your_email@gmail.com>"

# Optional Production Provider: Resend (https://resend.com)
RESEND_API_KEY=
ENABLE_LOCAL_EMAIL_CAPTURE=true

# ------------------------------------------------------------------------------
# 7. Frontend Public Environment (Exposed to Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 8. CORS & Security
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
