# Version control
.git
.gitignore
.github

# Dependencies & Virtualenvs
node_modules
apps/*/node_modules
packages/*/node_modules
.venv
apps/ai/.venv
__pycache__
*.pyc
*.pyo
*.pyd

# Build outputs & caches
dist
apps/*/dist
packages/*/dist
.next
apps/web/.next
.turbo
coverage

# Environment & Secrets (NEVER bake secrets into images)
.env
.env.*
!.env.example
!.env.production.example

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
postgres_data
redis_data
docker_data
*.dump
